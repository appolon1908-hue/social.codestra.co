  @@index([organizationId, createdAt])
}

model WebhookDeliveryAttempt {
  id             String               @id @default(uuid())
  eventId        String
  subscriptionId String
  attempt        Int
  state          WebhookDeliveryState @default(PENDING)
  nextAttemptAt  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  responseCode   Int?
  errorCode      String?
  responseBytes  Int?
  createdAt      DateTime             @default(now())
  event          WebhookEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription   WebhookSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, subscriptionId, attempt])
  @@index([state, nextAttemptAt])
  @@index([subscriptionId, createdAt])
}

model WebhookDeadLetter {
  id             String               @id @default(uuid())
  eventId        String
  subscriptionId String
  reasonCode     String
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  subscription   WebhookSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  replayAudits   WebhookReplayAudit[]

  @@unique([eventId, subscriptionId])
  @@index([subscriptionId, resolvedAt])
}

model WebhookReplayAudit {
  id           String            @id @default(uuid())
  deadLetterId String
  actorUserId  String
  reason       String
  createdAt    DateTime          @default(now())
  deadLetter   WebhookDeadLetter @relation(fields: [deadLetterId], references: [id], onDelete: Cascade)

  @@index([deadLetterId, createdAt])
}

enum WebhookDeliveryState {
