# Codestra Social integration environment template.
# Values are placeholders only. Do not commit live secrets.

CODESTRA_BUSINESS=codestra-social
CODESTRA_APPLICATION=social.codestra.co
CODESTRA_SERVICE=social-backend
CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=us
CODESTRA_SERVER=server-a
CODESTRA_DEPLOYMENT=git-sha-placeholder

CODESTRA_API_BASE=https://api.codestra.co
CODESTRA_AUTH_ISSUER=https://auth.codestra.co/realms/codestra
CODESTRA_AUTH_AUDIENCE=social-codestra

CODESTRA_INTAKE_BFF_ENABLED=false
CODESTRA_COMMUNICATIONS_ENABLED=false
CODESTRA_VOICE_CONTROLS_ENABLED=false
CODESTRA_MIDDLEWARE_CANARY_ENABLED=false
CODESTRA_N8N_ORCHESTRATION_ENABLED=false
CODESTRA_PROVIDER_LIVE_DELIVERY_ENABLED=false

METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_ALLOWED_IPS=

CODESTRA_SDK_INTAKE_CLIENT_ID=social-codestra
CODESTRA_SDK_INTAKE_CLIENT_SECRET_FILE=/run/secrets/social-codestra-intake-client-secret
CODESTRA_MIDDLEWARE_TOKEN_FILE=/run/secrets/social-codestra-middleware-token
CODESTRA_MIDDLEWARE_CLIENT_SECRET_FILE=/run/secrets/social-codestra-middleware-client-secret
WEBHOOK_MASTER_KEY_FILE=/run/secrets/webhook-master-key
PROVIDER_OAUTH_SEAL_KEY_FILE=/run/secrets/provider-oauth-seal-key
