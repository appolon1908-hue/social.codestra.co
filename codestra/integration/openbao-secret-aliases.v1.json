{
  "schemaVersion": "1.0",
  "application": "social.codestra.co",
  "status": "ALIAS_MANIFEST_ONLY",
  "authority": "Codestra-OpenBao",
  "gitMayContainSecretValues": false,
  "aliases": [
    {
      "name": "social-codestra/middleware/client-secret",
      "usedBy": "backend",
      "mountedAs": "CODESTRA_MIDDLEWARE_CLIENT_SECRET_FILE",
      "requiredBefore": "staging middleware canary"
    },
    {
      "name": "social-codestra/n8n/credential-reference",
      "usedBy": "n8n",
      "mountedAs": "n8n credential store item",
      "requiredBefore": "workflow import"
    },
    {
      "name": "social-codestra/webhook/master-key",
      "usedBy": "backend",
      "mountedAs": "WEBHOOK_MASTER_KEY_FILE",
      "requiredBefore": "signed webhook delivery"
    },
    {
      "name": "social-codestra/provider/oauth-seal-key",
      "usedBy": "backend",
      "mountedAs": "PROVIDER_OAUTH_SEAL_KEY_FILE",
      "requiredBefore": "provider command execution"
    }
  ],
  "forbiddenInGit": [
    "client_secret",
    "access_token",
    "refresh_token",
    "api_key",
    "smtp_password",
    "provider_oauth_token",
    "webhook_master_key"
  ]
}
